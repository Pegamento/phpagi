{
    "name": "pegamento/phpagi",
    "description": "PHPAGI is a PHP class for the Asterisk Gateway Interface.",
    "type": "library",
    "license": "LGPL-2.1-or-later",
    "autoload": {
        "classmap": [
            "src/phpagi.php",
            "src/phpagi-asmanager.php"
        ]
    },
    "require": {
        "php": ">=8.4"
    },
    "config": {
        "platform": {
            "php": "8.4"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5"
    },
    "autoload-dev": {
        "psr-4": {
            "PhpAgi\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:known-bugs": "phpunit --group known-bug"
    }
}
